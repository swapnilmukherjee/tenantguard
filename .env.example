AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your_regular_web_app_client_id
AUTH0_CLIENT_SECRET=your_regular_web_app_client_secret
AUTH0_SECRET=replace_with_openssl_rand_hex_32
APP_BASE_URL=http://localhost:3000

# API audience and scopes for Auth0 API authorization.
AUTH0_AUDIENCE=https://api.tenantguard.local
AUTH0_SCOPE=openid profile email read:dashboard read:audit_logs manage:users manage:settings read:billing
